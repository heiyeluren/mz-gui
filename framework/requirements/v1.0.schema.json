{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mz-gui.dev/schema/framework-requirements-v1.json",
  "title": "MZ-GUI-Framework v1.0 Requirements Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "requirements"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "release": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    }
  },
  "$defs": {
    "verification": {
      "enum": ["local-automated", "cross-compiled", "not-verified", "not-applicable"]
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id", "phase", "domain", "title", "priority", "implementation_status",
        "design_refs", "implementation_refs", "contract_refs", "test_refs", "evidence_refs", "gaps",
        "platform_verification"
      ],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^FW-[A-Z]+-[0-9]{3}$"},
        "phase": {"enum": ["F0", "F1", "F2", "F3", "F4", "F5", "F6"]},
        "domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "implementation_status": {"enum": ["implemented", "partial", "missing", "deferred"]},
        "design_refs": {"allOf": [{"$ref": "#/$defs/stringList"}, {"minItems": 1}]},
        "implementation_refs": {"$ref": "#/$defs/stringList"},
        "contract_refs": {"$ref": "#/$defs/stringList"},
        "test_refs": {"$ref": "#/$defs/stringList"},
        "evidence_refs": {"$ref": "#/$defs/stringList"},
        "gaps": {"$ref": "#/$defs/stringList"},
        "platform_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["macos-arm64", "macos-x86_64", "windows-x64"],
          "properties": {
            "macos-arm64": {"$ref": "#/$defs/verification"},
            "macos-x86_64": {"$ref": "#/$defs/verification"},
            "windows-x64": {"$ref": "#/$defs/verification"}
          }
        }
      }
    }
  }
}
