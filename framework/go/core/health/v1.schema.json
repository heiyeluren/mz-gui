{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mz-gui.dev/schema/framework-health-v1.json",
  "title": "MZ-GUI-Framework Health Check Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "checks"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "release": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "kind", "required", "description_key", "owner", "reason_codes"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"},
          "kind": {"enum": ["liveness", "readiness", "dependency"]},
          "required": {"type": "boolean"},
          "description_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
          "owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "contains": {"const": "core.not_observed"},
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"}
          }
        }
      }
    }
  }
}
