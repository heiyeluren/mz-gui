{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mz-gui-framework.local/schemas/managed-process/v1.schema.json",
  "title": "MZ-GUI Framework Managed Process Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "release", "states", "restart_policies", "probe_phases", "probe_statuses", "event_kinds", "reasons"],
  "properties": {
    "$schema": {"type": "string", "const": "./v1.schema.json"},
    "schema_version": {"type": "integer", "const": 1},
    "release": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["stopped", "starting", "running", "degraded", "backoff", "crash_loop", "incompatible", "stopping", "disabled"]}
    },
    "restart_policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["never", "on-failure", "always"]}
    },
    "probe_phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["readiness", "heartbeat"]}
    },
    "probe_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ready", "degraded", "not_ready", "incompatible"]}
    },
    "event_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["process.starting", "process.ready", "process.exited", "process.degraded", "process.crash_loop", "process.incompatible", "process.recovered", "process.stopped", "process.disabled"]}
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason_code", "event_kinds", "target_states"],
        "properties": {
          "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"},
          "event_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["process.starting", "process.ready", "process.exited", "process.degraded", "process.crash_loop", "process.incompatible", "process.recovered", "process.stopped", "process.disabled"]}
          },
          "target_states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["stopped", "starting", "running", "degraded", "backoff", "crash_loop", "incompatible", "stopping", "disabled"]}
          }
        }
      }
    }
  }
}
