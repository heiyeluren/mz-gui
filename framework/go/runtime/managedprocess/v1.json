    {"reason_code": "process.restart_scheduled", "event_kinds": ["process.degraded"], "target_states": ["backoff"]},
    {"reason_code": "process.launch_failed", "event_kinds": ["process.exited"], "target_states": ["stopped"]},
    {"reason_code": "process.crash_loop", "event_kinds": ["process.crash_loop"], "target_states": ["crash_loop"]},
    {"reason_code": "process.manual_retry", "event_kinds": ["process.recovered"], "target_states": ["stopped"]},
    {"reason_code": "process.stop_requested", "event_kinds": ["process.degraded"], "target_states": ["stopping"]},
    {"reason_code": "process.stopped", "event_kinds": ["process.stopped"], "target_states": ["stopped"]},
    {"reason_code": "process.disabled", "event_kinds": ["process.disabled"], "target_states": ["disabled"]},
    {"reason_code": "process.readiness_timeout", "event_kinds": ["process.exited"], "target_states": ["stopped"]},
    {"reason_code": "process.readiness_failed", "event_kinds": ["process.exited"], "target_states": ["stopped"]},
    {"reason_code": "process.health_degraded", "event_kinds": ["process.degraded"], "target_states": ["degraded"]},
