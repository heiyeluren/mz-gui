{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mz-gui.local/schema/telemetry-event-dictionary-v1.json",
  "title": "MZ-GUI Framework Telemetry Event Dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "propertyKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){0,15}$",
      "maxLength": 80
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "privacy_level", "required_properties", "allowed_properties"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){1,15}$"
        },
        "privacy_level": {
          "enum": ["operational", "sensitive", "restricted"]
        },
        "required_properties": {
          "type": "array",
          "items": {"$ref": "#/$defs/propertyKey"},
          "uniqueItems": true
        },
        "allowed_properties": {
          "type": "array",
          "items": {"$ref": "#/$defs/propertyKey"},
          "uniqueItems": true
        }
      }
    }
  }
}
